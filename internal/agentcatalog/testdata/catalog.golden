# launchable, in picker order
  claude
    name        Claude Code
    short       Claude
    command     claude
    skipPerms   --dangerously-skip-permissions
    aliases     claude-code
    adapter     claude-code
    resumeKinds id
    launch      claude
    launch+skip claude --dangerously-skip-permissions --model 'space value'
    resume/id   claude --resume SESSION
    resume/path error: provider "claude" cannot resume from a "path" reference; it resumes from: id
